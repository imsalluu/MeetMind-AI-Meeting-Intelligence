# ==============================================================================
# MeetMind — Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="MeetMind — AI Meeting Intelligence"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=meetmind_password
POSTGRES_DB=meetmind_db
DATABASE_URL=postgresql+asyncpg://meetmind:meetmind_password@localhost:5432/meetmind_db

# Redis & Worker Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
